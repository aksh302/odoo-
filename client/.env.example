# Copy to .env and adjust.

# true  = use the built-in fake API (src/api/mock/) — no backend needed
# false = call the real Express API for everything
VITE_USE_MOCKS=true

# Mixed mode (only when VITE_USE_MOCKS=true): send these API areas to the real server,
# keep the rest on mock data. Useful while the backend is half done. Example:
#   VITE_REAL_API=/auth,/products,/plans,/taxes
# Check which areas are ready with:  npm run check-api
VITE_REAL_API=

# Leave empty to use /api through the Vite proxy (vite.config.ts -> http://localhost:4000).
# Set a full URL only if the API runs somewhere else.
VITE_API_URL=

# true = Billing page shows a "Bill as of" date (needs DEMO_MODE=true on the server too)
VITE_DEMO_MODE=true

# Your company details, printed on invoices and used for the UPI QR and GST split.
# The GSTIN's first two digits are your state code (33 = Tamil Nadu).
VITE_COMPANY_NAME=Brightloop Software
VITE_COMPANY_ADDRESS=Chennai, Tamil Nadu
VITE_COMPANY_GSTIN=33AABCB1234L1Z9
VITE_UPI_ID=brightloop@upi
