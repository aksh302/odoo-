# Environment Variables for Brightloop SMS

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/brightloop

# JWT
JWT_SECRET=change-me-to-a-random-32-char-string-in-production
JWT_EXPIRES_IN=8h

# Client URL (CORS)
CLIENT_URL=http://localhost:5173

# SMTP (Mailtrap for dev)
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_mailtrap_user
SMTP_PASS=your_mailtrap_pass
MAIL_FROM=noreply@brightloop.dev

# Cron schedules (Asia/Kolkata)
BILLING_CRON=30 1 * * *
LIFECYCLE_CRON=0 1 * * *

# Demo mode (allows asOf parameter on billing run)
DEMO_MODE=true

# Timezone
TZ=Asia/Kolkata

# Server port
PORT=4000

# AI Configuration
AI_ENABLED=true
LLM_PROVIDER=gemini
LLM_API_KEY=your_llm_api_key
LLM_MODEL=gemini-2.0-flash
AI_TIMEOUT_MS=8000
AI_CACHE=true

