# Environment Variables for Brightloop SMS

# Database
# Homebrew or Postgres.app on a Mac: your Mac user, no password, so this works as is.
# Elsewhere: postgresql://USER:PASSWORD@localhost:5432/brightloop
DATABASE_URL=postgresql://localhost:5432/brightloop

# JWT
JWT_SECRET=change-me-to-a-random-32-char-string-in-production
JWT_EXPIRES_IN=8h

# Client URL (CORS)
CLIENT_URL=http://localhost:5173

# SMTP (Mailtrap for dev). Needed only to actually deliver invoice and reminder emails;
# without it the app still works and logs reminders on the invoice.
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_mailtrap_user
SMTP_PASS=your_mailtrap_pass
MAIL_FROM=noreply@brightloop.dev

# Cron schedules (Asia/Kolkata)
BILLING_CRON=30 1 * * *
LIFECYCLE_CRON=0 1 * * *

# Demo mode (allows asOf parameter on billing run)
DEMO_MODE=true

# Timezone
TZ=Asia/Kolkata

# Server port
PORT=4000

# AI Configuration
# Set AI_ENABLED=true and add a key to turn on the Copilot, reminder drafts and invoice
# explanations. With false they fall back to built-in answers.
AI_ENABLED=false
LLM_PROVIDER=gemini
LLM_API_KEY=your_llm_api_key
LLM_MODEL=gemini-2.0-flash
AI_TIMEOUT_MS=8000
AI_CACHE=true

